{
  "manifest_version": 3,
  "name": "AutoPlay",
  "version": "1.0.0",
  "description": "Smoothly advances to the next YouTube Short using native layout scrolling.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
